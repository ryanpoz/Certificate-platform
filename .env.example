# Copy this to .env.local and fill in your values
DATABASE_URL=postgresql://user:password@localhost:5432/certificate_platform

# Magic link JWT secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-secret-key-here

# Resend API Key (get from resend.com/api-keys)
# Leave empty to fall back to console logging
RESEND_API_KEY=

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000
